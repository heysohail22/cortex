GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Groq model to use
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase (vector store + future auth & sessions)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# Google Gemini (free cloud embeddings — no local model needed)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: LangSmith Tracing (automatically enabled by LangChain if set)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=cortex

# Jev router (server side only). Explicit rollback: ROUTER_PROVIDER=groq
ROUTER_PROVIDER=jev
TYPESAFE_API_KEY=your_typesafe_api_key_here
JEV_MODEL=jev
TIMEOUT_JEV=5.0
JEV_MAX_RETRIES=0
# Initial policy thresholds; calibrate with application examples.
JEV_SAFETY_THRESHOLD=0.7
JEV_REVIEW_THRESHOLD=0.35
JEV_INTENT_CONFIDENCE=0.6
MAX_CONCURRENT_CHATS=8

# Phase 2 evidence assessment and one correction
TIMEOUT_RETRIEVAL_STAGE=25
TIMEOUT_RETRIEVAL_REWRITE=4
MAX_EVIDENCE_CONTEXT_CHARS=8000
MAX_EVIDENCE_PASSAGE_CHARS=2000
MAX_EVIDENCE_CANDIDATES=10
JEV_EVIDENCE_INJECTION_MAX=0.35

# Generation baseline; explicitly opt into Gemini after account/model validation.
GENERATION_PROVIDER=groq
GENERATION_MODEL=openai/gpt-oss-120b
# Gemini candidate: GENERATION_PROVIDER=gemini, GENERATION_MODEL=gemini-3.5-flash-lite
GENERATION_TEMPERATURE=0.2
# Optional provider-specific setting; leave empty unless supported by selected model.
GENERATION_REASONING=
VERIFICATION_MODEL=openai/gpt-oss-120b
VERIFICATION_REASONING=
ANSWER_PROVIDER_RETRIES=0
MAX_ANSWER_OUTPUT_TOKENS=1600
MAX_VERIFICATION_OUTPUT_TOKENS=1800
MAX_ANSWER_CHARS=8000
MAX_ANSWER_CLAIMS=24
MAX_GENERATION_CONTEXT_CHARS=12000
TIMEOUT_ANSWER_STAGE=35
